{
  "name": "ghost-qa",
  "version": "1.3.1",
  "description": "Autonomous headless browser QA & self-healing verification loop for coding agents. Crawls localhost, traps console/network/layout failures, and feeds structured diagnostics back to the agent.",
  "type": "module",
  "bin": {
    "ghost-qa": "dist/bin/ghost-qa.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "scripts/prepare-build.mjs",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "node scripts/prepare-build.mjs",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "qa": "npm run build && npm test",
    "prepublishOnly": "npm run qa"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "claude-skills",
    "agent-skills",
    "ai-agents",
    "coding-agents",
    "playwright",
    "headless-browser",
    "qa-automation",
    "e2e-testing",
    "self-healing",
    "codex",
    "cursor",
    "cursorrules",
    "windsurf",
    "accessibility-testing",
    "a11y",
    "web-vitals",
    "performance-testing",
    "browser-testing",
    "test-automation",
    "automated-testing",
    "typescript",
    "cli",
    "devtools",
    "hydration",
    "ci-cd",
    "browser-verification",
    "agent-tools",
    "llm-agents",
    "frontend-qa",
    "mobile-testing"
  ],
  "author": "VibeFoundry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avivgerz-hue/ghost-qa.git"
  },
  "homepage": "https://github.com/avivgerz-hue/ghost-qa#readme",
  "bugs": {
    "url": "https://github.com/avivgerz-hue/ghost-qa/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
